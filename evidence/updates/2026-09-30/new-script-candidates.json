            }
          ]
        },
        {
          "id": "script-ppt20260930-yunduan-p023-s3-t2",
          "kind": "text",
          "text": "邹禾：你每次给我发天气的时候，是作为观测员发的，还是作为沈望发的？",
          "role": "邹禾",
          "color": "#E13448",
          "source_page": 23,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
          "runs": [
            {
              "text": "邹禾：你每次给我发天气的时候，是作为观测员发的，还是作为沈望发的？",
              "color": "#E13448"
            }
          ]
        },
        {
          "id": "script-ppt20260930-yunduan-p023-s3-t3",
          "kind": "text",
          "text": "沈望：每次给你发，是因为我是观测员，但观测员的背后还有一个沈望。",
          "role": "沈望",
          "color": "#18605A",
          "source_page": 23,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
          "runs": [
            {
              "text": "沈望：每次给你发，是因为我是观测员，但观测员的背后还有一个沈望。",
              "color": "#18605A"
            }
          ]
        },
        {
          "id": "script-ppt20260930-yunduan-p023-s3-t4",
          "kind": "text",
          "text": "邹禾：嗯？怎么说？",
          "role": "邹禾",
          "color": "#E13448",
          "source_page": 23,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
          "runs": [
            {
              "text": "邹禾：嗯？怎么说？",
              "color": "#E13448"
            }
          ]
        },
        {
          "id": "script-ppt20260930-yunduan-p023-s3-t5",
          "kind": "text",
          "text": "沈望：观测员会极力追求数据的准确，以确保全机组人员的安全，但沈望是在准确数据的背后担心着你的安全，默默记下你的落地时间，他比观测员还要担心你的安危，并且，有且只有你。",
          "role": "沈望",
          "color": "#18605A",
          "source_page": 23,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
          "runs": [
            {
              "text": "沈望：观测员会极力追求数据的准确，以确保全机组人员的安全，但沈望是在准确数据的背后担心着你的安全，默默记下你的落地时间，他比观测员还要担心你的安危，并且，有且只有你。",
              "color": "#18605A"
