        {
          "id": "script-ppt20260930-yunduan-p019-s3-t2",
          "kind": "text",
          "text": "沈望：（急切）你让机长接电话。",
          "role": "沈望",
          "color": "#18605A",
          "source_page": 19,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
