          "role": "邹禾",
          "color": "#E13448",
          "source_page": 20,
          "source_file": "示例内容源-A-更新版-2026-09-30.pptx",
          "runs": [
            {
              "text": "邹禾：（愣）什么？",
              "color": "#E13448"
